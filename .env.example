# TRUE SELF® — Variables d'environnement requises

# Mot de passe d'administration (obligatoire côté serveur)
ADMIN_PASSWORD=trueself2026

# Clé secrète pour chiffrer les cookies de session (au moins 32 caractères aléatoires)
ADMIN_SESSION_SECRET=trueself_super_secure_admin_session_secret_2026_at_least_32_chars

# Supabase (Base de données persistante gratuite)
# À récupérer sur votre projet Supabase : Settings > API
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre_cle_anon_ou_service_role

# Numéro WhatsApp boutique pour la confirmation des commandes (format international sans le +, ex: 212612345678)
VITE_WHATSAPP_NUMBER=212600000000
